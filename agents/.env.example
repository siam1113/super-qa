# ============================================
# LLM CONFIGURATION
# Goal: Power AI agents for test generation and business analysis
# ============================================

# Provider Options: openai | anthropic | ollama
LLM_PROVIDER=openai

# Model Options (based on provider):
# - OpenAI: gpt-4 | gpt-4-turbo | gpt-3.5-turbo
# - Anthropic: claude-3-opus | claude-3-sonnet | claude-3-haiku
# - Ollama: llama2 | codellama | mistral | custom models
LLM_MODEL=gpt-4

# Temperature Range: 0.0 (deterministic) to 1.0 (creative)
# Recommended: 0.7 for balanced responses
LLM_TEMPERATURE=0.7


# ============================================
# LLM PROVIDER API KEYS
# Configure based on your chosen LLM_PROVIDER
# ============================================

# Example 1: OpenAI (default)
OPENAI_API_KEY=

# Example 2: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-sonnet
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
ANTHROPIC_API_KEY=

# Example 3: Ollama (local/self-hosted)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434


# ============================================
# SERVICE CONFIGURATION
# ============================================
PORT=8000
REDIS_URL=redis://localhost:6379

# Backend API URL - connects to main QA platform API
BACKEND_API_URL=http://localhost:4000/api
AGENT_SOURCE_IDS=

# Standalone bounded harness worker and operator CLI. Match the API's distinct keys.
# Keep operator credentials out of the worker deployment.
HARNESS_WORKER_KEY=
HARNESS_OPERATOR_KEY=

# Standalone container-only browser worker; do not grant it operator/model-provider keys.
HARNESS_EXECUTOR_KEY=
HARNESS_BROWSER_IMAGE=superqa-browser:v1
# JSON map of target IDs to absolute, trusted, self-contained static app directories.
HARNESS_BROWSER_TARGETS={}

# Separate scoped suite worker/CI process; select a runner or CI key, never both roles.
AUTONOMY_PROJECT_KEY=
AUTONOMY_ALLOWED_ORIGINS=[]
# Optional origin -> environment variable NAME, not the credential value.
AUTONOMY_SECRET_REFS={}
# Empty blocks all private/local addresses. Explicit trusted CIDRs are required for internal staging.
AUTONOMY_ALLOWED_CIDRS=[]
# Optional trusted private CA bundle. Certificate/hostname verification remains enabled.
AUTONOMY_CA_FILE=
AUTONOMY_LIVE_PROFILE_PATHS={}
AUTONOMY_LIVE_IMAGE=
AUTONOMY_LIVE_STATE=


# ============================================
# TEST EXECUTION
# Goal: Target URL for running automated tests
# ============================================

# Development Environment
DEV_URL=http://localhost:3000

# Additional Environments (optional)
# STAGING_URL=https://staging.example.com
# PRODUCTION_URL=https://app.example.com
AGENT_MEMORY_SIGNING_KEY=CHANGE_ME

# QA skill workflows. Direct HTTP calls require a separate >=32-character key.
QA_WORKFLOW_KEY=
# Default: agents/.qa-workflows/runs.sqlite3. Mount durable storage for deployment.
QA_WORKFLOW_DB=
# Named repositories available for read-only framework inspection and code generation.
# Example: {"web-app":"/workspace/web-app"}
QA_REPOSITORIES={}
# Stdio QA MCP server expert role (requires Python >=3.10 and requirements-mcp.txt).
QA_MCP_ROLE=qae
# CLI/MCP/internal HTTP scope; local is a trusted single-workspace operator context.
QA_WORKFLOW_SCOPE=local
# Signed organization chat uses the authenticated project UUID instead.
# Example: {"project-uuid":{"repositories":["web-app"],"browser_targets":["fixture"],"readiness_profiles":["staging-observation"],"harness_scope":{"workspaceId":"workspace","applicationId":"app","environment":"staging"}}}
QA_WORKFLOW_RESOURCES={}

# Live exploration through native agent-browser MCP (Python >=3.10).
# IDs use the same browser_targets app-scope bindings as static browser targets.
# Example: {"staging":{"base_url":"https://staging.example.com/","allowed_domains":["staging.example.com","api.example.com"],"allow_interactions":true,"auth_profile":"staging-qa","ready_selector":"[data-testid=app-ready]"}}
QA_BROWSER_TARGETS={}
# Optional absolute agent-browser executable; otherwise agents/browser-mcp install or PATH.
QA_AGENT_BROWSER_BIN=

# Deterministic test-readiness profiles. Only configured URLs are probed.
# Add profile IDs to each app's QA_WORKFLOW_RESOURCES.readiness_profiles list.
# Example: {"staging-observation":{"environment":"staging","target_id":"staging","target_probe":{"url":"https://staging.example.com/","expected_status":200},"required_checks":["target_http","browser_adapter"],"ttl_seconds":60}}
# Optional checks: target_revision, repository, credentials, execution_worker.
# For revision checks set target_probe.revision_pointer and supply expected_target_revision.
# For worker checks set worker_probe.url and worker_probe.ready_pointer (must return JSON true).
QA_READINESS_PROFILES={}
# New app-scoped artifacts publish to BACKEND_API_URL using AGENT_MEMORY_SIGNING_KEY.
# The local durable outbox retries publication in the running agent service.

# Versioned requirement snapshot files (absolute JSON paths, operator-managed).
# Grant IDs in QA_WORKFLOW_RESOURCES.requirement_profiles for each app.
# Example: {"checkout":"/srv/qa/requirements/checkout.json"}
QA_REQUIREMENT_PROFILES={}

# Reproducible synthetic fixture blueprints. Grant IDs in workflow resources.dataset_profiles.
QA_DATASET_PROFILES={}
# Approved durable suites. Grant IDs in workflow resources.automation_suites.
# {"smoke":{"project_id":"project UUID","suite_id":"approved suite UUID","profile_hash":"profile SHA-256","project_key_env":"QA_SUITE_PROJECT_KEY"}}
QA_AUTOMATION_SUITES={}
# The value of QA_SUITE_PROJECT_KEY must be a project-scoped API key. Never expose it in inputs.
# Repository worker configuration (on the worker host, not the conversational agent).
AUTONOMY_REPOSITORIES={}
AUTONOMY_REPOSITORY_PROFILE_PATHS={}
AUTONOMY_DATASET_PROFILE_PATHS={}
AUTONOMY_REPOSITORY_NETWORKS=["none"]
AUTONOMY_REPOSITORY_STATE=

# API sequence worker: immutable profile files keyed by their SHA-256; private durable state.
# Public metadata generation: python -m shared.harness.api_flow /absolute/api-profile.json
# Reuse QA_AUTOMATION_SUITES and workflow resources.automation_suites for agent admission.
AUTONOMY_API_PROFILE_PATHS={}
AUTONOMY_API_STATE=

# Read-only regression policies, keyed by ID with absolute JSON paths.
# Grant IDs in workflow resources.regression_profiles plus underlying repositories/suites.
QA_REGRESSION_PROFILES={}

# Read-only release-gate policies, keyed by ID with absolute JSON paths.
# {"required_suites":[{"suite_profile_id":"smoke","mandatory":true}],"min_design_coverage_percent":80,"max_open_findings":0,"evidence_ttl_seconds":3600}
# Grant IDs in workflow resources.release_policies plus underlying automation_suites/repositories.
QA_RELEASE_POLICIES={}
