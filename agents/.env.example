# ============================================
# QA Agents Service - Environment Configuration
# ============================================

# --------------------------------------------
# LLM Provider Configuration
# --------------------------------------------

# Select your LLM provider: openai, anthropic, or ollama
LLM_PROVIDER=openai

# Model to use (provider-specific)
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Ollama: llama3.1, mistral, codellama, etc.
LLM_MODEL=gpt-4

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.7

# Max tokens for responses (optional)
# LLM_MAX_TOKENS=4096

# --------------------------------------------
# Provider API Keys
# --------------------------------------------

# OpenAI API Key (required for OpenAI provider)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (required for Anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Ollama Configuration (for local LLMs)
OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------
# Agent-Specific Overrides (Optional)
# --------------------------------------------

# QAE Agent
# QAE_PROVIDER=openai
# QAE_MODEL=gpt-4
# QAE_TEMPERATURE=0.7

# AUE Agent
# AUE_PROVIDER=openai
# AUE_MODEL=gpt-4
# AUE_TEMPERATURE=0.5

# Super QA Agent
# SUPERQA_PROVIDER=openai
# SUPERQA_MODEL=gpt-4
# SUPERQA_TEMPERATURE=0.5

# --------------------------------------------
# Service Configuration
# --------------------------------------------

# Port for the agents service
PORT=8000

# Redis URL for session management
REDIS_URL=redis://localhost:6379

# Backend API URL (NestJS)
BACKEND_API_URL=http://localhost:4000/api

# --------------------------------------------
# Test Runner Configuration
# --------------------------------------------

# Directory containing Playwright tests
TESTS_DIR=./tests

# Directory for test results
RESULTS_DIR=./test-results

# Base URLs for different environments
DEV_URL=http://localhost:3000
STAGING_URL=https://staging.example.com
PROD_URL=https://example.com
