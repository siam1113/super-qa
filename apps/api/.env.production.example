# Copy to apps/api/.env.production and fill in. Loaded via env_file in
# docker-compose.prod.yml. Infra values (DATABASE_*, REDIS_*, NEO4J_*, S3_*,
# PORT, WEB_ORIGIN, AUTH_PUBLIC_URL, AGENTS_API_URL, AUTONOMY_LOCKDOWN,
# AUTONOMY_ALLOWED_ORIGINS) are already set by docker-compose.prod.yml from
# the root .env file — do not repeat them here.

# ============================================
# AI EMBEDDINGS & EXTRACTION (required for context extraction features)
# ============================================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-large
EXTRACTION_PROVIDER=local
EXTRACTION_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ============================================
# ORGANIZATION ACCOUNTS / EMAIL
# ============================================
AUTH_FROM_EMAIL=
RESEND_API_KEY=

# Configure all four to enable SSO; leave blank to disable.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ============================================
# AGENT MEMORY / HARNESS
# ============================================
# 32+ random bytes, e.g.: openssl rand -hex 32
AGENT_MEMORY_SIGNING_KEY=

# Bounded autonomy proposal harness — leave all blank to keep it disabled.
HARNESS_OPERATOR_KEY=
HARNESS_WORKER_KEY=
HARNESS_EXECUTOR_KEY=
HARNESS_WORKSPACE_ID=
HARNESS_APPLICATION_ID=
HARNESS_ENVIRONMENT=
HARNESS_SOURCE_IDS=
HARNESS_PROVIDER=
HARNESS_MODEL=
HARNESS_INPUT_NANO_USD=
HARNESS_OUTPUT_NANO_USD=
HARNESS_EXECUTION_TARGETS={}

# ============================================
# OPTIONAL INTEGRATIONS (leave blank to skip)
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

CHAT_MODEL=
CHAT_SECRET_KEY=
CHAT_DAILY_REPLY_LIMIT=100
CHAT_WORKER_ENABLED=true
TEAMS_SHARED_APP_ID=
TEAMS_SHARED_APP_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

MEETING_STUN_URL=
MEETING_TURN_URL=
MEETING_TURN_SECRET=
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
RECALL_REGION=us-west-2
MEETING_PUBLIC_API_URL=
MEETING_LIVE_ENABLED=false
MEETING_LIVE_MODEL=gpt-live-1
MEETING_LIVE_VOICE=marin
VOICE_PREVIEW_MODEL=gpt-4o-mini-tts
LAYA_API_URL=
LAYA_API_KEY=

# ============================================
# PERFORMANCE / PROTECTION (sane production defaults)
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
DATABASE_QUERY_TIMEOUT=30000
REQUEST_TIMEOUT=120000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60000

AUTONOMY_REPOSITORY_PROFILES={}
AUTONOMY_API_PROFILES={}
