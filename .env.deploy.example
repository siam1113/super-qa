# Copy to .env (repo root) on the server. docker compose reads this file
# automatically to fill in the ${VAR} placeholders in docker-compose.prod.yml.
# These are infra-level values only — app secrets (API keys, etc.) live in
# apps/api/.env.production and agents/.env.production instead.

# The domain pointing at this server, e.g. qa.example.com. No scheme, no path.
DOMAIN=

# Generate secrets with: openssl rand -hex 24
DATABASE_USER=qaagent
DATABASE_PASSWORD=
DATABASE_NAME=qaagent

NEO4J_PASSWORD=

# MinIO (self-hosted S3) root credentials.
S3_ACCESS_KEY=qaagent
S3_SECRET_KEY=
