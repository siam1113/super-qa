{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "admin:create-super-admin": "npm run build && node scripts/create-super-admin.js",
    "test": "jest test/unit test/simple.test.ts",
    "test:unit": "jest test/unit --verbose",
    "test:pipeline-recovery": "jest test/integration/pipeline-recovery.test.ts --runInBand",
    "test:qa-workflows": "jest test/integration/qa-workflows.test.ts --runInBand",
    "test:harness": "jest test/integration/harness.test.ts --runInBand",
    "test:browser-execution": "jest test/integration/browser-execution.test.ts --runInBand",
    "test:autonomy": "jest test/integration/autonomy.test.ts --runInBand",
    "test:chat": "jest test/integration/chat.test.ts --runInBand",
    "test:chat:ui": "CHAT_UI_E2E=1 jest test/integration/chat.test.ts --runInBand",
    "test:evidence-e2e": "jest test/integration/pipeline-recovery.test.ts --runInBand --testNamePattern='HTTP sync'",
    "test:watch": "jest test/unit --watch",
    "test:cov": "jest test/unit test/simple.test.ts --coverage",
    "test:e2e": "jest --testMatch='**/test/e2e/**/*.e2e.spec.ts'",
    "test:sync-pipeline": "jest --testMatch='**/test/e2e/sync-pipeline.e2e.spec.ts'",
    "test:mocks": "jest test/unit/mocks.test.ts --verbose",
    "healthcheck:embedding": "ts-node test/healthcheck/test-embedding.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@huggingface/inference": "^2.8.0",
    "@nestjs/bull": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@octokit/rest": "^19.0.13",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "jira.js": "^4.0.0",
    "mammoth": "^1.13.0",
    "neo4j-driver": "^6.2.0",
    "openai": "^4.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "pgvector": "^0.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20",
    "word-extractor": "^1.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "@types/word-extractor": "^1.0.6",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
