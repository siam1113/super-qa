# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Organization accounts, invitations and optional OIDC SSO
AUTH_PUBLIC_URL=http://localhost:3000
AUTH_FROM_EMAIL=Super QA <onboarding@resend.dev>
RESEND_API_KEY=
# Configure all four OIDC variables to enable SSO; redirect URI points to the web app proxy callback.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback


# ============================================
# PRIMARY DATABASE (PostgreSQL)
# Goal: Store application data, business context, test cases
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=qaagent
DATABASE_PASSWORD=qaagent123
DATABASE_NAME=qaagent


# ============================================
# BACKGROUND JOBS (Redis)
# Goal: Queue processing for sync pipelines and extraction jobs
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379


# ============================================
# AI EMBEDDINGS & EXTRACTION
# Goal: Generate embeddings for semantic search and extract business context
# ============================================

# Embedding Provider Options: local | openai | huggingface
EMBEDDING_PROVIDER=local

# Embedding Model Options (based on provider):
# - OpenAI: text-embedding-3-large | text-embedding-3-small | text-embedding-ada-002
# - HuggingFace: sentence-transformers/all-MiniLM-L6-v2 | custom models
# - Local: Uses default local model
EMBEDDING_MODEL=text-embedding-3-large

# Extraction Provider Options: local | openai | anthropic
EXTRACTION_PROVIDER=local

# Extraction Model Options (based on provider):
# - OpenAI: gpt-4o | gpt-4-turbo | gpt-3.5-turbo
# - Anthropic: claude-opus-4-5-20251101 | claude-sonnet-4-5-20250929 | claude-3-5-sonnet-20241022
# - Local: Uses regex pattern matching only (no AI validation)
EXTRACTION_MODEL=claude-sonnet-4-5-20250929

# Provider API Keys (required based on provider choice)
OPENAI_API_KEY=

# Organization chat. Select a Chat Completions model supporting JSON mode.
CHAT_MODEL=
# 32 random bytes encoded as 64 hex characters; required for Slack/Teams secrets.
CHAT_SECRET_KEY=
CHAT_DAILY_REPLY_LIMIT=100
CHAT_WORKER_ENABLED=true

# One shared, multi-tenant Azure Bot app serving every client org (see docs/chat-and-text-integrations.md).
# Its single messaging endpoint is https://YOUR_API/api/chat-hooks/teams; each client tenant is onboarded
# by the admin clicking "Install to your organization" (GET /api/chat/installations/teams/connect-url),
# granting org-wide admin consent in Microsoft's own flow, and landing back on
# https://YOUR_API/api/chat-hooks/teams/consent, which is where the connection is created.
TEAMS_SHARED_APP_ID=
TEAMS_SHARED_APP_SECRET=

# One shared, multi-tenant Slack app serving every client org, installed via Slack's own OAuth
# "Add to Slack" flow (GET /api/chat/installations/slack/install-url) — the Teams admin-consent
# flow above follows the same shape.
# Its OAuth redirect URL is https://YOUR_API/api/chat-hooks/slack/oauth/callback and its Events API
# Request URL is https://YOUR_API/api/chat-hooks/slack (no installation ID in either path).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Native calls: provision your own STUN/TURN; TURN credentials are short-lived HMACs.
MEETING_STUN_URL=
MEETING_TURN_URL=
MEETING_TURN_SECRET=

# Optional external Teams/Google Meet pilot, independent of text bot credentials.
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
RECALL_REGION=us-west-2
MEETING_PUBLIC_API_URL=

# Optional GPT-Live speech-to-speech participation. Requires model account access.
# Off preserves legacy text participation. See docs/live-meeting-voice.md.
MEETING_LIVE_ENABLED=false
MEETING_LIVE_MODEL=gpt-live-1
MEETING_LIVE_VOICE=marin

# Voice tab "Listen" preview (standard text-to-speech, independent of GPT-Live above).
# Uses OPENAI_API_KEY; override the model if your account needs a different one.
VOICE_PREVIEW_MODEL=gpt-4o-mini-tts

ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Local Laya classifier (laya-ai.com) for the "is this message asking me to join a
# call right now" check in 3rd-party chats — zero marginal cost, no OpenAI/Anthropic
# call. Run `laya-serve` locally (see agents/.venv-laya); defaults to localhost:8000.
LAYA_API_URL=http://localhost:8000
LAYA_API_KEY=


# ============================================
# OAUTH INTEGRATIONS
# Goal: Connect to external sources (GitHub, Jira, Confluence)
# ============================================
API_URL=http://localhost:4000

# GitHub Integration (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian Integration - Jira & Confluence (optional)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=


# ============================================
# BLOB STORAGE
# Goal: Store uploaded files, documents, and attachments
# Provider Options: S3 (AWS) | MinIO (self-hosted) | DigitalOcean Spaces | Cloudflare R2
# ============================================

# Example 1: MinIO (local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=qaagent
S3_SECRET_KEY=qaagent123
S3_BUCKET=qa-agent-files

# Example 2: AWS S3 (production)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET=my-qa-agent-bucket

# Example 3: DigitalOcean Spaces
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_REGION=nyc3
# S3_ACCESS_KEY=DO00ABC123DEF456GHI
# S3_SECRET_KEY=abcdef1234567890abcdef1234567890
# S3_BUCKET=my-qa-space


# ============================================
# GRAPH DATABASE (Neo4j - Optional)
# Goal: Store and query business context relationships
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qaagent123


# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================

# AI Agents Service - if using separate agents microservice
AGENTS_API_URL=http://localhost:8000
AGENT_MEMORY_SIGNING_KEY=CHANGE_ME


# ============================================
# SYSTEM PROTECTION & PERFORMANCE
# Goal: Prevent server crashes, infinite loops, and resource exhaustion
# ============================================

# Rate Limiting - Prevents too many requests from overwhelming the server
# TTL: Time window in seconds for counting requests
# LIMIT: Maximum requests allowed per TTL window per IP
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Database Query Timeout - Prevents long-running queries from hanging
# Timeout in milliseconds (0 = no timeout)
# Recommended: 30000 (30 seconds) for most queries
DATABASE_QUERY_TIMEOUT=30000

# HTTP Request Timeout - Maximum time for a single HTTP request
# Timeout in milliseconds
# Recommended: 120000 (2 minutes) for sync operations
REQUEST_TIMEOUT=120000

# Durable proposal harness: disabled until scope, keys, model and price schedule are set.
# Use distinct random secrets of at least 32 characters; never expose them in browser variables.
HARNESS_OPERATOR_KEY=
HARNESS_WORKER_KEY=
HARNESS_WORKSPACE_ID=
HARNESS_APPLICATION_ID=
HARNESS_ENVIRONMENT=
HARNESS_SOURCE_IDS=
HARNESS_PROVIDER=
HARNESS_MODEL=
# Explicit integer nano-USD per token (1 USD = 1,000,000,000 nano-USD).
# Configure your actual price schedule. Explicit 0 is permitted for local/no-charge inference.
HARNESS_INPUT_NANO_USD=
HARNESS_OUTPUT_NANO_USD=

# Separate browser-executor capability. Must differ from operator and model-worker keys.
HARNESS_EXECUTOR_KEY=
# JSON map of approved offline target IDs to SHA-256 bundle digests. No URLs accepted.
HARNESS_EXECUTION_TARGETS={}

# Secure project control plane. Production always locks out unscoped legacy routes.
# Enabling this also disables the legacy UI's unauthenticated API paths.
AUTONOMY_LOCKDOWN=false
# Explicit HTTPS origins authorized by the deployment administrator, with no trailing slash.
AUTONOMY_ALLOWED_ORIGINS=[]
AUTONOMY_LIVE_PROFILES={}

# Circuit Breaker - Stops calling failing services to prevent cascading failures
# FAILURE_THRESHOLD: Number of failures before circuit opens
# SUCCESS_THRESHOLD: Number of successes needed to close circuit
# TIMEOUT: Time in milliseconds before trying again after circuit opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60000

# Approved repository profile metadata, keyed by hash of the worker's profile file.
# Generate with: python -m shared.harness.repository profile /absolute/profile.json
AUTONOMY_REPOSITORY_PROFILES={}

# Approved API sequence metadata, keyed by SHA-256 of the worker profile file.
# Generate with: python -m shared.harness.api_flow /absolute/api-profile.json
AUTONOMY_API_PROFILES={}
