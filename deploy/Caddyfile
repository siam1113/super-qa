{$DOMAIN} {
	encode gzip

	@agents path /agents/*
	handle @agents {
		uri strip_prefix /agents
		reverse_proxy agents:8000
	}

	# Next.js-only wrapper routes (apps/web/app/api/...) that don't mirror a
	# same-path NestJS route — they call a *different* backend path (health
	# checks) or add a session-cookie gate of their own. Must be matched
	# before the generic @api catch-all below, or Caddy sends them straight
	# to the backend, which has no matching route and 404s.
	@webapi path /api/status /api/admin/status
	handle @webapi {
		reverse_proxy web:3000
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:4000
	}

	# Static marketing site and product demo, bind-mounted read-only into this
	# container (see docker-compose.prod.yml) — both use relative asset paths
	# (styles.css, app.js), so a bare /demo or /marketing (no trailing slash)
	# must redirect first or the browser resolves those paths one level up.
	redir /demo /demo/ permanent
	@demo path /demo/*
	handle @demo {
		uri strip_prefix /demo
		root * /srv/demo
		file_server
	}

	redir /marketing /marketing/ permanent
	@marketing path /marketing/*
	handle @marketing {
		uri strip_prefix /marketing
		root * /srv/marketing
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
