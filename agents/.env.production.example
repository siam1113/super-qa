# Copy to agents/.env.production and fill in. Loaded via env_file in
# docker-compose.prod.yml. Infra values (PORT, REDIS_URL, BACKEND_API_URL)
# are already set by docker-compose.prod.yml — do not repeat them here.

# ============================================
# LLM CONFIGURATION
# ============================================
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_TEMPERATURE=0.7

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# AGENT MEMORY / WORKFLOWS
# ============================================
# Must match apps/api/.env.production's AGENT_MEMORY_SIGNING_KEY.
AGENT_MEMORY_SIGNING_KEY=

AGENT_SOURCE_IDS=

# Standalone bounded harness worker keys — leave blank to keep disabled,
# and never set both operator and worker/executor keys on the same deployment.
HARNESS_WORKER_KEY=
HARNESS_OPERATOR_KEY=
HARNESS_EXECUTOR_KEY=

# QA skill workflows — leave default (no direct HTTP workflow access) unless needed.
QA_WORKFLOW_KEY=
QA_WORKFLOW_DB=
QA_MCP_ROLE=qae
QA_WORKFLOW_SCOPE=local
